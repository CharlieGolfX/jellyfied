# Optional settings for Jellyplex. Everything here has a default, so this file is only needed
# when you want to change something without editing docker-compose.yml:
#
#   cp .env.example .env
#
# .env is read by `docker compose` and by `npm run dev`.

# --- Jellyfin server ---------------------------------------------------------

# Jellyfin address as reachable FROM THE JELLYPLEX CONTAINER. Jellyplex proxies it at /jellyfin,
# so the browser only ever talks to Jellyplex (no CORS or mixed-content issues).
#   Same compose project / Docker network:  http://jellyfin:8096
#   Jellyfin on the Docker host:            http://host.docker.internal:8096
#   Another machine on your LAN:            http://192.168.1.10:8096
#   Behind a base URL:                      http://jellyfin:8096/jellyfin
# Set it to nothing (JELLYFIN_URL=) to let users type the server address on the login screen.
JELLYFIN_URL=http://host.docker.internal:8096

# Optional: address the BROWSER should use to reach Jellyfin directly, instead of going through
# the proxy, e.g. https://jellyfin.example.com
JELLYFIN_PUBLIC_URL=

# Optional: true/false. When true, users can't switch to a different server on the login screen.
# Empty means: true when a server is configured above, false otherwise.
JELLYPLEX_LOCK_SERVER=

# Optional: the reverse proxies or tunnels in front of Jellyplex whose X-Forwarded-For header is
# believed, as addresses or networks separated by spaces, e.g. "172.18.0.0/16 10.0.0.2".
# "private" (the default) trusts loopback and the private ranges; "none" trusts nobody.
JELLYPLEX_TRUSTED_PROXIES=private

# --- Container ---------------------------------------------------------------

# Port on the Docker host that Jellyplex is published on.
JELLYPLEX_HOST_PORT=8080

# Host address to publish that port on. 0.0.0.0 makes it reachable from your network;
# 127.0.0.1 keeps it to this machine (for example when a reverse proxy runs in front of it).
JELLYPLEX_BIND_ADDRESS=0.0.0.0

# --- Development (npm run dev) -----------------------------------------------

# Jellyfin address as reachable from YOUR MACHINE, when it differs from JELLYFIN_URL above
# (for example http://localhost:8096). Empty means: use JELLYFIN_URL.
JELLYFIN_DEV_URL=

# Port of the development server.
JELLYPLEX_DEV_PORT=5173
