{
  "name": "jellyfied",
  "private": true,
  "version": "1.6.1",
  "type": "module",
  "description": "A web frontend for Jellyfin",
  "license": "GPL-3.0-or-later",
  "author": "CharlieGolfX",
  "repository": "github:CharlieGolfX/jellyfied",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:visual": "sh scripts/visual-tests.sh",
    "test:visual:update": "sh scripts/visual-tests.sh --update-snapshots",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api": "node scripts/generate-api-types.mjs",
    "test:container": "docker build -t jellyfied:ci . && node docker/test-container.mjs jellyfied:ci",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "size": "node scripts/bundle-size.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.3",
    "jassub": "^2.5.23",
    "libpgs": "^0.9.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
